# Cloudflare Pages headers

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: interest-cohort=(), camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'
  Access-Control-Allow-Origin: *
  # Edge-cache HTML. Two facts make this both work AND stay fresh:
  #  1. CF treats text/html as DYNAMIC and ignores s-maxage UNLESS a Cache Rule
  #     marks the zone "cache eligible / respect origin TTL" (one exists on this
  #     zone's cache phase, ruleId 273b8576). With it, the edge honours s-maxage.
  #  2. A CF Pages deploy does NOT purge that rule's edge entries, so freshness is
  #     handled by .github/workflows/purge-on-deploy.yml: it fires on CF Pages'
  #     GitHub check run completing for main and purge_everything's the zone, so a
  #     deployed change is live within ~1 min regardless of the TTL below.
  # Because purge-on-deploy guarantees freshness, s-maxage is LONG (1 day) to
  # maximise the cache-hit ratio between deploys. Browsers still revalidate
  # (max-age=0). If you ever disable that purge workflow, drop s-maxage back to
  # ~600. Immutable /_astro/* keep their 1yr rule below.
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=86400
  Link: </llms.txt>; rel="alternate"; type="text/plain"; title="llms.txt", </.well-known/agent.json>; rel="alternate"; type="application/json"; title="agent-card", </.well-known/api-catalog>; rel="api-catalog", </sitemap-index.xml>; rel="sitemap"

# /browser pages run models IN the tab (the playground), which the global
# policy above forbids. This rule detaches and replaces exactly two headers,
# scoped to /browser/*; everything else keeps the strict global policy.
#   CSP deltas vs global (each one load-bearing, verified against a live run):
#   - connect-src + huggingface.co / *.huggingface.co / *.hf.co: model weights
#     (HF 302s resolve/ downloads to regional CDN hosts under hf.co, e.g.
#     us.aws.cdn.hf.co; CSP checks every hop of the redirect chain)
#   - script-src blob: + worker-src blob:: onnxruntime-web bridges its WASM
#     module through blob: URLs (the runtimes themselves are self-hosted
#     under /ort/, copied by scripts/copy-ort-wasm.mjs; jsdelivr was dropped
#     from this policy when that landed)
#   - script-src 'wasm-unsafe-eval': WebAssembly compilation is blocked by any
#     CSP without it
#   - img-src blob: (cut-out PNGs, picked images), media-src blob: (Kokoro's
#     synthesized WAV in <audio>)
#   - connect-src https://localmodel.run: same-origin on prod anyway; listed
#     explicitly so localfit's refresh() also works on *.pages.dev previews
#   Permissions-Policy: microphone=(self) so the Whisper page can record;
#   everything else stays denied.
/browser/*
  ! Content-Security-Policy
  ! Permissions-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://localmodel.run https://cloudflareinsights.com https://huggingface.co https://*.huggingface.co https://*.hf.co; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'
  Permissions-Policy: interest-cohort=(), camera=(), microphone=(self), geolocation=(), payment=(), usb=()

# Self-hosted onnxruntime WASM runtimes (see scripts/copy-ort-wasm.mjs).
# Not immutable: the filenames are version-less, so a dependency bump changes
# the bytes behind the same URL. One day matches /og; purge-on-deploy handles
# the edge, browsers revalidate daily.
# ! Cache-Control first: CF Pages merges the /* block into every specific
# block, and a merged duplicate ("max-age=0 ..., max-age=86400") makes
# browsers honor the FIRST max-age=0 (the exact bug /_astro hit before its
# zone rule). Detaching keeps only the value below.
/ort/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Hashed assets are immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=86400

# Embeddable SVG badges (HuggingFace/GitHub READMEs). Long cache; deploy-purge busts it.
/badge/*
  Content-Type: image/svg+xml; charset=utf-8
  Cache-Control: public, max-age=86400

/.well-known/agent.json
  Content-Type: application/json; charset=utf-8

/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
  Cache-Control: public, max-age=3600

/api/*
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
