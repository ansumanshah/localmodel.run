---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import GuideToc from "@/components/GuideToc.astro";
import Sources from "@/components/Sources.astro";
import { dedupeSources, meta, models } from "@/lib/data";
import { estimateMemory } from "@/lib/compute";
import { breadcrumbLd, faqLd, techArticleLd, truncate, type FaqItem } from "@/lib/seo";

const codingIds = ["qwen2.5-coder-7b", "qwen2.5-coder-14b", "qwen3-coder-30b-a3b"];
const codingModels = codingIds.map((id) => {
  const model = models.find((candidate) => candidate.id === id);
  if (!model) throw new Error(`can-you-run-claude-locally: missing ${id}`);
  return {
    model,
    at4k: estimateMemory(model, "q4_k_m", 4),
    at64k: estimateMemory(model, "q4_k_m", 64),
  };
});

const path = "/guides/can-you-run-claude-locally";
const title = "Can you run Claude locally? What Claude Code and Ollama change · localmodel.run";
const description = truncate(
  "Anthropic has not published local Claude weights or GGUF files. Claude Code can use a separately hosted local Ollama model, with memory estimates for three coding models at 4K and 64K context.",
);
const OFFICIAL_SOURCES = [
  "https://docs.ollama.com/integrations/claude-code",
  "https://code.claude.com/docs/en/overview",
  "https://platform.claude.com/docs/en/models/overview",
  "https://ollama.com/download",
];
const SOURCES = dedupeSources(OFFICIAL_SOURCES, ...codingModels.map(({ model }) => model.sources ?? []));

const faqs: FaqItem[] = [
  {
    q: "Can you run Anthropic Claude locally?",
    a: "No. Anthropic's published Claude model catalog describes cloud/API models, and Anthropic has not published Claude weights or GGUF files for local inference. A local model used through Claude Code is a different model.",
  },
  {
    q: "Can Claude Code use a local model?",
    a: "Yes. Claude Code is the app and coding harness, not the model weights. Ollama documents its Claude Code integration, where you can choose a locally hosted model. That does not make the local model Claude or establish matching quality or tool behavior.",
  },
  {
    q: "How much memory does a local coding model need?",
    a: `It depends on the model and context window. In the estimates below, ${codingModels[0].model.name} needs about ${codingModels[0].at4k.totalGb} GB at 4K context and ${codingModels[0].at64k.totalGb} GB at 64K. The weights are only part of the total; the KV cache grows with context.`,
  },
];

const jsonLd = [
  breadcrumbLd(
    [
      { name: "Home", url: "/" },
      { name: "Guides", url: "/guides" },
      { name: "Can you run Claude locally?", url: path },
    ],
    Astro.site!.href,
  ),
  techArticleLd({
    headline: "Can you run Claude locally?",
    description,
    url: path,
    origin: Astro.site!.href,
    dateModified: "2026-09-12",
    datePublished: "2026-09-12",
    sources: OFFICIAL_SOURCES,
    speakableSelector: [".guide-tldr"],
  }),
  faqLd(faqs),
];
---

<Base
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  ogTitle="Can you run Claude locally?"
  ogType="article"
  articleModified="2026-09-12"
  ogImageAlt="Can you run Claude locally?"
>
  <article class="mx-auto max-w-3xl px-4 py-8">
    <Breadcrumbs
      items={[
        { name: "Home", url: "/" },
        { name: "Guides", url: "/guides" },
        { name: "Can you run Claude locally?", url: path },
      ]}
    />

    <p class="eyebrow mt-4"><span class="dot" aria-hidden="true"></span>Guide &middot; Local coding</p>
    <h1 class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-4xl">Can you run Claude locally?</h1>
    <p class="mt-4 text-pretty text-lg text-muted-foreground">
      <strong class="text-foreground">Anthropic does not offer Claude weights for local download</strong>
      in its published model catalog. You can use the Claude Code CLI with a
      separately hosted local model through Ollama. Claude Code is the coding tool; the selected model supplies the responses.
    </p>

    <div class="panel guide-tldr mt-6">
      <div class="panel-head"><span class="panel-label">The short version</span></div>
      <p class="p-4 text-sm text-muted-foreground">
        Claude is available through Anthropic's cloud/API catalog, not as published local weights.
        <a href="https://docs.ollama.com/integrations/claude-code" class="text-[var(--brand-ink)] hover:underline">Ollama's Claude Code integration</a>
        lets the Claude Code harness select a local model. That is useful for a local workflow, but
        it is not a local Claude release and does not promise Claude-equivalent quality, behavior, or tools.
      </p>
    </div>

    <GuideToc
      items={[
        { id: "what-is-local", label: "What is and is not local" },
        { id: "use-ollama", label: "Use Claude Code with Ollama" },
        { id: "memory", label: "Memory for local coding models" },
        { id: "faq", label: "FAQ" },
      ]}
    />

    <section class="mt-8">
      <h2 id="what-is-local" class="scroll-mt-20 text-xl font-semibold">What is and is not local</h2>
      <p class="mt-2 text-muted-foreground">
        Anthropic's <a href="https://platform.claude.com/docs/en/models/overview" class="text-[var(--brand-ink)] hover:underline">model overview</a>
        lists Claude as a cloud/API offering. It does not publish the model weights or a GGUF download,
        so there is no Claude file to put on your Mac, PC, or phone for offline inference. This answer
        was checked on 12 September 2026.
      </p>
      <p class="mt-3 text-muted-foreground">
        Claude Code is a coding environment that works in the terminal, IDEs, desktop app, and web.
        Its <a href="https://code.claude.com/docs/en/overview" class="text-[var(--brand-ink)] hover:underline">official overview</a>
        also documents third-party providers for the CLI. A local provider changes where the selected
        model runs. It does not turn that model into Claude.
      </p>
    </section>

    <section class="mt-8">
      <h2 id="use-ollama" class="scroll-mt-20 text-xl font-semibold">Use Claude Code with Ollama</h2>
      <p class="mt-2 text-muted-foreground">
        Install <a href="https://ollama.com/download" class="text-[var(--brand-ink)] hover:underline">Ollama</a>
        and <a href="https://code.claude.com/docs/en/overview" class="text-[var(--brand-ink)] hover:underline">Claude Code</a>,
        then follow <a href="https://docs.ollama.com/integrations/claude-code" class="text-[var(--brand-ink)] hover:underline">Ollama's integration guide</a>. Launch with:
      </p>
      <pre class="panel mt-3 overflow-x-auto p-4 font-mono text-sm"><code>ollama launch claude</code></pre>
      <p class="mt-3 text-muted-foreground">
        The guide lets you choose local or cloud models. Ollama uses its local endpoint on port 11434 by
        default and recommends 64K or more context for large repositories. Choose a local model that
        fits your hardware, then check its own documentation and licenses. Some external tools or services
        used by a coding workflow may still need network access.
      </p>
    </section>

    <section class="mt-8">
      <h2 id="memory" class="scroll-mt-20 text-xl font-semibold">Memory for local coding models</h2>
      <p class="mt-2 text-muted-foreground">
        These examples show memory requirements; we have not tested these models with Claude Code. The totals use
        this site's Q4_K_M memory estimate: measured weights where available, plus an estimated KV cache
        and <span class="num">{codingModels[0].at4k.overheadGb} GB</span> runtime overhead. A 64K context can be valuable for a repository, but it costs much
        more memory. Use the <a href="/calculator" class="text-[var(--brand-ink)] hover:underline">calculator</a>
        for your device and the <a href="/leaderboard/coding" class="text-[var(--brand-ink)] hover:underline">coding leaderboard</a>
        for sourced benchmark coverage.
      </p>
      <div class="panel mt-3 overflow-x-auto" role="region" aria-label="Local coding model memory estimates" tabindex="0">
        <table class="w-full min-w-[38rem] text-sm">
          <caption class="sr-only">Estimated Q4_K_M memory at 4K and 64K context for three coding models.</caption>
          <thead class="border-b border-border text-left text-muted-foreground">
            <tr>
              <th scope="col" class="px-4 py-3 font-medium">Local coding model</th>
              <th scope="col" class="px-4 py-3 font-medium">Q4_K_M weights</th>
              <th scope="col" class="px-4 py-3 font-medium">Est. total, 4K</th>
              <th scope="col" class="px-4 py-3 font-medium">Est. total, 64K</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {codingModels.map(({ model, at4k, at64k }) => (
              <tr>
                <th scope="row" class="px-4 py-3 text-left font-medium">
                  <a href={`/model/${model.id}`} class="hover:underline">{model.name}</a>
                </th>
                <td class="px-4 py-3 font-mono text-muted-foreground">{at4k.weightsGb} GB</td>
                <td class="px-4 py-3 font-mono text-muted-foreground">~{at4k.totalGb} GB</td>
                <td class="px-4 py-3 font-mono text-muted-foreground">~{at64k.totalGb} GB</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">
        Memory-data refresh: {meta.updated}. These are model-memory estimates, not total system RAM requirements;
        leave room for the operating system, coding tools and other apps. See the
        <a href="/methodology" class="text-[var(--brand-ink)] hover:underline">memory methodology</a>
        for assumptions. Larger context also needs support and configuration in the model and runtime.
      </p>
    </section>

    <section class="mt-10">
      <h2 id="faq" class="scroll-mt-20 text-xl font-semibold">FAQ</h2>
      <div class="panel mt-3 divide-y divide-border">
        {faqs.map((faq) => (
          <div class="p-4">
            <p class="font-medium">{faq.q}</p>
            <p class="mt-2 text-sm text-muted-foreground">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    <p class="mt-8 text-sm text-muted-foreground">
      Weighing a local model against a hosted Claude API? <a href="/compare/local-vs-cloud" class="text-[var(--brand-ink)] underline underline-offset-2">Compare local models, Claude, Astra and Gemini</a>
      using preference ratings, your hardware's memory and monthly API token costs.
    </p>
    <Sources urls={SOURCES} />
  </article>
</Base>
