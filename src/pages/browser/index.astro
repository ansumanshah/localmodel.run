---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import {
  browserModels,
  browserModelsByTask,
  browserTopComputedInsight,
  formatBytes,
  formatParamsM,
  meta,
} from "@/lib/data";
import { browserTaskGroups } from "@/lib/browser-tasks";
import { breadcrumbLd, faqLd, itemListLd, techArticleLd, truncate, type FaqItem } from "@/lib/seo";
import { playgroundTaskFor } from "@/components/playground/registry";

const path = "/browser";
const LARGE_BYTES = 1500 * 1024 * 1024;
const isLarge = (bytes: number) => bytes >= LARGE_BYTES;

// Precomputed in frontmatter (not inline in the nested map below): each
// model's single most notable computed insight, when one fires, for a
// one-line card annotation so the hub reads as 54 distinct rows, not 54
// copies of one template.
const groups = browserModelsByTask().map((g) => ({
  ...g,
  rows: g.models.map((m) => ({ model: m, topInsight: browserTopComputedInsight(m) })),
}));

// Tasks that earn their own hub page under /browser/task (2+ models). The set
// comes from the same helper the hub route uses, so a heading never links to a
// page that was not generated.
const hubTasks = new Set(browserTaskGroups().map((g) => g.task));

const title = `${browserModels.length} AI models that run in your browser · localmodel.run`;
const description = truncate(
  `${browserModels.length} models that run entirely in the browser with Transformers.js over WebGPU or WebAssembly: no server, no install, no account. Measured download sizes from the HuggingFace API, not estimates.`,
);

const faqs: FaqItem[] = [
  {
    q: "What does 'runs in the browser' actually mean?",
    a: "The model weights (converted to ONNX) download once to the browser cache, then inference runs locally in the tab via Transformers.js, using WebGPU if the browser supports it or WebAssembly as a fallback. Nothing is sent to a server after the download.",
  },
  {
    q: "WebGPU or WASM: which should I use?",
    a: "WebGPU is faster and usually the smaller download (the q4f16 quant), but it needs browser support. WebGPU now ships by default in current Chrome, Edge, Safari (26+), and Firefox on Windows and Apple Silicon Macs; older browser versions and Firefox on Linux may still lack it. WASM works everywhere but is slower and often needs a larger int8 build. Each model page below has a live check for your current browser.",
  },
  {
    q: "Are these the same models as the main GGUF catalog?",
    a: "No. The main catalog tracks GGUF models for native runtimes (Ollama, llama.cpp, LM Studio) on a device you install software on. This page tracks ONNX exports built specifically for Transformers.js in a browser tab, a different runtime with its own size measurements.",
  },
];

const jsonLd = [
  breadcrumbLd([{ name: "Home", url: "/" }, { name: "Browser", url: path }], Astro.site!.href),
  techArticleLd({
    headline: "Local AI models that run in the browser",
    description,
    url: path,
    origin: Astro.site!.href,
    dateModified: meta.updated,
    datePublished: meta.launched,
    speakableSelector: [".verdict-text"],
  }),
  faqLd(faqs),
  itemListLd({
    name: "Browser AI models (Transformers.js)",
    items: browserModels.map((m) => ({ name: m.name, url: `/browser/${m.id}` })),
    origin: Astro.site!.href,
  }),
];
---

<Base title={title} description={description} path={path} jsonLd={jsonLd} ogType="website">
  <div class="relative overflow-hidden border-b border-border">
    <div class="mx-auto max-w-3xl px-4 py-10">
      <Breadcrumbs items={[{ name: "Home", url: "/" }, { name: "Browser", url: path }]} />

      <p class="eyebrow mt-4">
        <span class="dot" aria-hidden="true"></span>
        {browserModels.length} models &middot; Transformers.js &middot; WebGPU / WASM
      </p>
      <h1 class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-4xl">
        Local AI that runs <span class="accent">in the browser</span>
      </h1>
      <p class="verdict-text mt-4 text-pretty text-lg text-muted-foreground">
        {browserModels.length} models, one tab each: no install, no server, no Ollama. They run with <a href="https://huggingface.co/docs/transformers.js" rel="noopener nofollow" class="underline">Transformers.js</a> over WebGPU or WebAssembly, and every download size below is <strong class="text-foreground">measured from the HuggingFace API</strong>, not estimated.
      </p>
      <p class="mt-3 text-sm text-muted-foreground">
        Not sure what this browser can handle? Run the <a href="/browser/check" class="text-[var(--brand-ink)] underline">browser capability check</a>: WebGPU support, adapter, memory limits, and how many of these {browserModels.length} models fit here.
      </p>
      <p class="mt-3 text-sm text-muted-foreground">
        Running models outside the browser? See the <a href="/can-i-run" class="text-[var(--brand-ink)] underline">main GGUF catalog</a> for native runtimes (Ollama, llama.cpp, LM Studio) across desktop and mobile hardware.
      </p>

      <div class="wire mt-6" aria-hidden="true"></div>

      <nav class="mt-4 flex flex-wrap gap-2" aria-label="Jump to model type">
        {groups.map((g) => (
          <a
            href={`#${g.task}`}
            class="inline-flex items-center gap-1.5 rounded-[3px] border border-[color-mix(in_oklch,var(--color-brand)_25%,transparent)] bg-[color-mix(in_oklch,var(--color-brand)_6%,transparent)] px-3 py-1.5 font-mono text-xs tracking-wide text-[var(--brand-ink)] transition-colors hover:bg-[color-mix(in_oklch,var(--color-brand)_12%,transparent)]"
          >
            {g.label} <span class="opacity-60">&middot; {g.models.length}</span>
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-4 py-8">
    <div class="space-y-10">
      {groups.map((g) => (
        <section id={g.task} class="scroll-mt-20">
          <div class="panel overflow-hidden">
            <div class="panel-head">
              <span class="panel-label">{g.label}</span>
              {hubTasks.has(g.task) ? (
                <a href={`/browser/task/${g.task}`} class="panel-label text-[var(--brand-ink)] underline">
                  {g.models.length} model{g.models.length === 1 ? "" : "s"}, compared &rarr;
                </a>
              ) : (
                <span class="panel-label opacity-60">{g.models.length} model{g.models.length === 1 ? "" : "s"}</span>
              )}
            </div>
            <ul class="divide-y divide-border">
              {g.rows.map(({ model: m, topInsight }) => (
                <li>
                  <a
                    href={`/browser/${m.id}`}
                    class="flex items-center justify-between gap-3 p-4 transition-colors hover:bg-[color-mix(in_oklch,var(--color-brand)_6%,transparent)]"
                  >
                    <span class="min-w-0">
                      <span class="flex min-w-0 items-center gap-2">
                        <span class="truncate font-medium">{m.name}</span>
                        {playgroundTaskFor(m) && <span class="tag shrink-0">Live run</span>}
                      </span>
                      <span class="mt-0.5 block text-xs text-muted-foreground">
                        {m.params_m != null ? <>{formatParamsM(m.params_m)} params &middot; </> : null}
                        {m.pipeline_task ?? "custom setup"}
                        {isLarge(Math.max(m.headline.webgpu.bytes, m.headline.wasm.bytes)) && <span class="ml-1.5 text-[var(--verdict-tight-fg)]">&middot; large download</span>}
                      </span>
                      {topInsight && (
                        <span class="mt-1 block truncate text-[11px] text-muted-foreground/80">
                          {topInsight.map((part) => (typeof part === "string" ? part : <span class="num">{part.num}</span>))}
                        </span>
                      )}
                    </span>
                    <span class="shrink-0 text-right">
                      <span class="num block text-lg font-semibold text-[var(--brand-ink)]">{formatBytes(m.headline.webgpu.bytes)}</span>
                      <span class="block font-mono text-[10px] uppercase tracking-wide text-muted-foreground">WebGPU &middot; {m.headline.webgpu.variant}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>

    <section class="mt-12">
      <p class="eyebrow mb-3"><span class="dot" aria-hidden="true"></span>FAQ</p>
      <div class="panel divide-y divide-border">
        {faqs.map((f) => (
          <div class="p-4">
            <p class="font-medium">{f.q}</p>
            <p class="mt-2 text-sm text-muted-foreground">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <p class="mt-6 text-xs text-muted-foreground">
      Sizes measured 2026-08-01 from the HuggingFace API file tree for each repo. Last validated {meta.updated}. See <a href="/methodology" class="underline">methodology</a>.
    </p>
  </div>
</Base>
