---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Sources from "@/components/Sources.astro";
import {
  browserModels,
  browserLedeAction,
  browserQuantPlainWords,
  browserReadingBullets,
  browserSizeNeighbors,
  BROWSER_TASK_LABEL,
  formatBytes,
  formatParamsM,
  meta,
} from "@/lib/data";
import { breadcrumbLd, faqLd, techArticleLd, truncate, type FaqItem } from "@/lib/seo";
import Playground from "@/components/playground/Playground";
import { PLAYGROUND_RUN_OVERRIDES, PLAYGROUND_TASKS } from "@/components/playground/registry";

export function getStaticPaths() {
  return browserModels.map((model) => ({ params: { model: model.id }, props: { model } }));
}

const { model } = Astro.props;
const path = `/browser/${model.id}`;
const taskLabel = BROWSER_TASK_LABEL[model.task] ?? model.task;
const webgpuSize = formatBytes(model.headline.webgpu.bytes);
const wasmSize = formatBytes(model.headline.wasm.bytes);
const { smaller, bigger } = browserSizeNeighbors(model);
const readingBullets = browserReadingBullets(model);
const ledeAction = browserLedeAction(model);

// Smallest first; flag whichever row IS the webgpu/wasm headline pick.
const variantRows = Object.entries(model.variants)
  .sort((a, b) => a[1] - b[1])
  .map(([variant, bytes]) => ({
    variant,
    bytes,
    isWebgpu: variant === model.headline.webgpu.variant && bytes === model.headline.webgpu.bytes,
    isWasm: variant === model.headline.wasm.variant && bytes === model.headline.wasm.bytes,
  }));

// A real pipeline() call when a stable transformers.js task exists for this
// model; otherwise a verified per-model low-level snippet (model.code_snippet,
// checked against the model's own card or the official transformers.js
// examples repo) when one exists; otherwise no code block at all (see below,
// notes + a link to the HF card instead of guessing unverifiable code).
const snippet = model.pipeline_task
  ? `import { pipeline } from "@huggingface/transformers";

const pipe = await pipeline("${model.pipeline_task}", "${model.hf_repo}", {
  device: "webgpu", // usually falls back to "wasm"; wrap in try/catch for production
  dtype: "${model.headline.webgpu.variant}", // use "${model.headline.wasm.variant}" for the WASM build
});

const result = await pipe(/* your input */);`
  : (model.code_snippet ?? null);

const title = `${model.name}: browser download size (WebGPU/WASM) · localmodel.run`;
const description = truncate(
  `${model.name} downloads ${webgpuSize} over WebGPU (${model.headline.webgpu.variant}), or ${wasmSize} over WebAssembly (${model.headline.wasm.variant}), to run entirely in the browser with Transformers.js. Measured sizes for every quant, a live WebGPU check, and a copy-paste snippet.`,
);

// Exactly 2 questions, each answering something not already stated verbatim
// elsewhere on the page: which browsers actually run WebGPU vs. fall back,
// and what the recommended quant trades away in plain words.
const faqs: FaqItem[] = [
  {
    q: `WebGPU or WASM for ${model.name}, in practice?`,
    a: `Chrome, Edge, and Safari 26+ run the WebGPU build (${model.headline.webgpu.variant}) on the GPU. Firefox has WebGPU on Windows and Apple Silicon Macs but not everywhere yet. Any browser without a WebGPU adapter falls back automatically to the WebAssembly build (${model.headline.wasm.variant}) on CPU: same model, slower to load, slower to run.`,
  },
  {
    q: `What does ${model.headline.webgpu.variant} mean for ${model.name}?`,
    a: `The WebGPU build here uses ${model.headline.webgpu.variant}: ${browserQuantPlainWords(model.headline.webgpu.variant)}. The WASM fallback uses ${model.headline.wasm.variant}: ${browserQuantPlainWords(model.headline.wasm.variant)}.`,
  },
];

const jsonLd = [
  breadcrumbLd(
    [
      { name: "Home", url: "/" },
      { name: "Browser", url: "/browser" },
      { name: model.name, url: path },
    ],
    Astro.site!.href,
  ),
  techArticleLd({
    headline: `${model.name} browser download size`,
    description,
    url: path,
    origin: Astro.site!.href,
    dateModified: meta.updated,
    datePublished: meta.launched,
    speakableSelector: [".verdict-text"],
    sources: model.sources.map((s) => s.url),
  }),
  faqLd(faqs),
];

// Fed to the client-side WebGPU check (no recompute needed, just labels).
const fitData = {
  webgpuLabel: `${webgpuSize} (${model.headline.webgpu.variant})`,
  wasmLabel: `${wasmSize} (${model.headline.wasm.variant})`,
};

// The nine flagship pages carry a live "Run it" island (the only client JS on
// /browser); it subsumes the static WebGPU live-check below.
const playgroundTask = PLAYGROUND_TASKS[model.id];
// What the live run loads per backend: the headline pick unless an override
// names a different (in-browser-verified) variant; bytes always come from the
// measured variants table, never restated by hand.
const playgroundOverride = PLAYGROUND_RUN_OVERRIDES[model.id];
const runPick = (backend: "webgpu" | "wasm") => {
  const variant = playgroundOverride?.[backend] ?? model.headline[backend].variant;
  const bytes = model.variants[variant];
  if (bytes == null) throw new Error(`Playground override variant "${variant}" not measured for ${model.id}`);
  return { variant, bytes };
};
const playgroundModel = playgroundTask
  ? {
      id: model.id,
      name: model.name,
      hf_repo: model.hf_repo,
      headline: model.headline,
      run: { webgpu: runPick("webgpu"), wasm: runPick("wasm") },
      ...(playgroundOverride?.note ? { runNote: playgroundOverride.note } : {}),
    }
  : null;
---

<Base title={title} description={description} path={path} jsonLd={jsonLd} ogType="article" articleModified={meta.updated}>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <Breadcrumbs items={[{ name: "Home", url: "/" }, { name: "Browser", url: "/browser" }, { name: model.name, url: path }]} />

    <p class="eyebrow mt-4"><span class="dot" aria-hidden="true"></span>Runs in the browser &middot; {taskLabel}</p>
    <h1 class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-4xl">
      Run {model.name} in your browser
    </h1>
    <p class="verdict-text mt-4 text-pretty text-lg text-foreground">
      <strong>{model.name} downloads {webgpuSize}</strong> over WebGPU ({model.headline.webgpu.variant}), or {wasmSize} over WebAssembly ({model.headline.wasm.variant}), to {ledeAction} entirely in the tab with <a href="https://huggingface.co/docs/transformers.js" rel="noopener nofollow" class="underline">Transformers.js</a>. No install, no server.
    </p>
    <p class="mt-2 text-pretty text-muted-foreground">
      {taskLabel} &middot; <code class="rounded bg-card px-1.5 py-0.5 text-sm">{model.hf_repo}</code>
    </p>

    <section class="mt-6">
      <div class="panel overflow-hidden">
        <div class="grid grid-cols-2 divide-x divide-border">
          <div class="p-4">
            <div class="stat-label">WebGPU download</div>
            <div class="stat-val mt-1.5 text-2xl"><span class="num">{webgpuSize}</span></div>
            <div class="mt-0.5 text-xs text-muted-foreground">{model.headline.webgpu.variant}</div>
          </div>
          <div class="p-4">
            <div class="stat-label">WASM download</div>
            <div class="stat-val mt-1.5 text-2xl"><span class="num">{wasmSize}</span></div>
            <div class="mt-0.5 text-xs text-muted-foreground">{model.headline.wasm.variant}</div>
          </div>
        </div>
        <div class="wire" aria-hidden="true"></div>
        <dl class="flex flex-wrap gap-x-6 gap-y-3 px-4 py-3">
          <div class="stat">
            <dt class="stat-label">Parameters</dt>
            <dd class="stat-val text-base">{model.params_m != null ? <span class="num">{formatParamsM(model.params_m)}</span> : "-"}</dd>
          </div>
          <div class="stat">
            <dt class="stat-label">Pipeline task</dt>
            <dd class="stat-val text-base">{model.pipeline_task ?? "custom"}</dd>
          </div>
        </dl>
      </div>
    </section>

    {readingBullets.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-semibold">Reading</h2>
        <div class="panel divide-y divide-border">
          {readingBullets.map((parts) => (
            <p class="p-4 text-sm text-muted-foreground">
              {parts.map((part) => (typeof part === "string" ? part : <span class="num">{part.num}</span>))}
            </p>
          ))}
        </div>
      </section>
    )}

    {playgroundTask && playgroundModel && (
      <section class="mt-8">
        <h2 class="sr-only">Run it in your browser</h2>
        <div class="panel-hero" id="playground">
          <div class="panel-head">
            <span class="panel-label">Live run</span>
            <span class="panel-label">this browser</span>
          </div>
          <div class="p-5">
            <Playground client:idle model={playgroundModel} task={playgroundTask} />
            <noscript>
              <p class="text-sm text-muted-foreground">Enable JavaScript to run {model.name} live in this tab. The numbers above stand either way.</p>
            </noscript>
          </div>
        </div>
      </section>
    )}

    {!playgroundTask && (
    <section class="mt-8">
      <h2 class="sr-only">Will it run in your browser?</h2>
      <div class="panel-hero" id="browser-check">
        <div class="panel-head">
          <span class="panel-label">Live check</span>
          <span class="panel-label">this browser</span>
        </div>
        <div class="p-5">
          <p class="text-sm text-muted-foreground" id="bc-loading">Checking for WebGPU support&hellip;</p>
          <span class="verdict-stamp hidden" id="bc-stamp">
            <svg id="bc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"></svg>
            <span id="bc-word"></span>
          </span>
          <p class="mt-2 text-sm text-muted-foreground" id="bc-note"></p>
          <noscript>
            <p class="text-sm text-muted-foreground">Enable JavaScript to check whether your browser supports WebGPU for this model. Either way, it can fall back to WebAssembly on CPU.</p>
          </noscript>
        </div>
      </div>
      <script type="application/json" id="bc-data" set:html={JSON.stringify(fitData).replace(/</g, "\\u003c")} is:inline />
      <script is:inline>
        (function () {
          var ICONS = {
            yes: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
            tight: '<circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/>',
            no: '<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/>',
          };
          var FG = { yes: "var(--verdict-yes-fg)", tight: "var(--verdict-tight-fg)", no: "var(--verdict-no-fg)" };
          function render(kind, word, note) {
            var stamp = document.getElementById("bc-stamp");
            if (!stamp) return;
            stamp.setAttribute("data-v", kind);
            stamp.style.color = FG[kind];
            var icon = document.getElementById("bc-icon");
            if (icon) icon.innerHTML = ICONS[kind];
            var wordEl = document.getElementById("bc-word");
            if (wordEl) wordEl.textContent = word;
            var noteEl = document.getElementById("bc-note");
            if (noteEl) noteEl.textContent = note;
            stamp.classList.remove("hidden");
            var loading = document.getElementById("bc-loading");
            if (loading) loading.classList.add("hidden");
          }
          async function check() {
            var blob = document.getElementById("bc-data");
            var data = blob ? JSON.parse(blob.textContent || "{}") : {};
            if (typeof WebAssembly === "undefined") {
              render("no", "Can't run here", "Neither WebGPU nor WebAssembly is available in this browser.");
              return;
            }
            if (navigator.gpu) {
              try {
                var adapter = await navigator.gpu.requestAdapter();
                if (adapter) {
                  render("yes", "WebGPU available", "Downloads " + data.webgpuLabel + ".");
                  return;
                }
              } catch (e) {
                /* fall through to WASM */
              }
            }
            render("tight", "Falls back to WASM", "No WebGPU adapter found; downloads " + data.wasmLabel + " instead, slower.");
          }
          check();
        })();
      </script>
    </section>
    )}

    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold">All measured variants</h2>
      <div class="panel overflow-hidden">
        <div class="panel-head">
          <span class="panel-label">Quant</span>
          <span class="panel-label">Download size</span>
        </div>
        <table class="w-full text-sm">
          <thead class="sr-only">
            <tr>
              <th scope="col">Variant</th>
              <th scope="col">Size</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {variantRows.map((v) => (
              <tr class={v.isWebgpu || v.isWasm ? "bg-[color-mix(in_oklch,var(--color-brand)_10%,transparent)]" : ""}>
                <td class="px-4 py-2 font-medium">
                  {v.variant}
                  {v.isWebgpu && <span class="tag ml-2">WebGPU pick</span>}
                  {v.isWasm && <span class="tag ml-2">WASM pick</span>}
                </td>
                <td class="px-4 py-2 text-right text-muted-foreground"><span class="num">{formatBytes(v.bytes)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-muted-foreground">Sizes measured from the HuggingFace API file tree for <code class="rounded bg-card px-1 py-0.5">{model.hf_repo}</code>, not estimated.</p>
    </section>

    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold">Use it with Transformers.js</h2>
      {snippet ? (
        <>
          <div class="group relative">
            <div class="relative rounded-[4px] border border-[var(--lite-rim)] bg-[color-mix(in_oklch,var(--card)_62%,transparent)] p-4 font-mono text-xs shadow-[inset_0_1px_0_0_var(--lite-specular)] before:absolute before:inset-y-2 before:left-0 before:w-0.5 before:rounded-[1px] before:bg-[var(--color-brand)] before:content-['']">
              <pre class="overflow-x-auto whitespace-pre pr-16 leading-relaxed"><code>{snippet}</code></pre>
              <button
                type="button"
                class="copy-btn absolute right-3 top-3 shrink-0 rounded-md border border-border bg-card px-2 py-1 text-[11px] text-muted-foreground opacity-0 transition hover:text-foreground group-hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                data-copy={snippet}
                aria-label="Copy code"
              >
                Copy
              </button>
            </div>
          </div>
          <p class="mt-2 text-xs text-muted-foreground">
            Requires <code class="rounded bg-card px-1 py-0.5">npm install @huggingface/transformers</code> (or the CDN build). {!model.pipeline_task && "This model needs the lower-level API shown above, not pipeline() (see the Reading panel above)."}
          </p>
        </>
      ) : (
        <p class="text-sm text-muted-foreground">
          There is no stable transformers.js <code class="rounded bg-card px-1 py-0.5">pipeline()</code> call for this model yet, and no verified low-level snippet either (see the Reading panel above). Check the <a href={`https://huggingface.co/${model.hf_repo}`} rel="noopener nofollow" class="underline">model card on HuggingFace</a> for current usage examples.
        </p>
      )}
    </section>

    <Sources urls={model.sources.map((s) => s.url)} />

    {(smaller || bigger) && (
      <section class="mt-10">
        <h2 class="text-lg font-semibold">Same job, different size</h2>
        <div class="mt-3 divide-y divide-border rounded-lg border border-border">
          {smaller && (
            <a href={`/browser/${smaller.id}`} class="flex items-center justify-between gap-3 px-3 py-2 text-sm transition-colors hover:bg-[color-mix(in_oklch,var(--color-brand)_6%,transparent)]">
              <span class="truncate">&larr; {smaller.name}</span>
              <span class="num shrink-0 text-muted-foreground">{formatBytes(smaller.headline.webgpu.bytes)}</span>
            </a>
          )}
          {bigger && (
            <a href={`/browser/${bigger.id}`} class="flex items-center justify-between gap-3 px-3 py-2 text-sm transition-colors hover:bg-[color-mix(in_oklch,var(--color-brand)_6%,transparent)]">
              <span class="truncate">{bigger.name} &rarr;</span>
              <span class="num shrink-0 text-muted-foreground">{formatBytes(bigger.headline.webgpu.bytes)}</span>
            </a>
          )}
        </div>
      </section>
    )}

    <section class="mt-10">
      <h2 class="text-lg font-semibold">FAQ</h2>
      <div class="panel mt-3 divide-y divide-border">
        {faqs.map((f) => (
          <div class="p-4">
            <p class="font-medium">{f.q}</p>
            <p class="mt-2 text-sm text-muted-foreground">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <p class="mt-6 text-xs text-muted-foreground">
      Sizes measured 2026-08-01 from the HuggingFace API. Last validated {meta.updated}. See <a href="/browser" class="underline">all browser models</a> or the <a href="/methodology" class="underline">methodology</a>.
    </p>
  </div>
</Base>
