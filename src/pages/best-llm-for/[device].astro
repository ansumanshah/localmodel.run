---
import Base from "@/layouts/Base.astro";
import { setupHref } from "@/lib/setup-link";
import { supportsSetupModel } from "@/lib/setup";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import VerdictBadge from "@/components/VerdictBadge.astro";
import Sources from "@/components/Sources.astro";
import EntityIcon from "@/components/EntityIcon.astro";
import {
  devices,
  modelsBySize,
  getTool,
  devicePlatform,
  platformLabel,
  dedupeSources,
  meta,
} from "@/lib/data";
import { canRun, estimateMemory, usableGb, QUANT_LABEL } from "@/lib/compute";
import {
  breadcrumbLd,
  faqLd,
  howToLd,
  itemListLd,
  techArticleLd,
  truncate,
  type FaqItem,
} from "@/lib/seo";

export function getStaticPaths() {
  return devices.map((device) => ({ params: { device: device.id }, props: { device } }));
}

const { device } = Astro.props;
const usable = usableGb(device);
const platform = devicePlatform(device);
const tool = getTool(platform);

const ranked = modelsBySize
  .map((m) => ({ model: m, result: canRun(m, device) }))
  .sort((a, b) => b.model.params_b - a.model.params_b);
const fitting = ranked.filter((r) => r.result.verdict !== "no");
const notFitting = ranked.filter((r) => r.result.verdict === "no");
// Fit distribution for the at-a-glance bar: how the whole tracked catalog splits
// on this device (runs well / tight fit / too heavy), shown in the verdict palette.
const yesCount = ranked.filter((r) => r.result.verdict === "yes").length;
const tightCount = ranked.filter((r) => r.result.verdict === "tight").length;
const noCount = notFitting.length;
// Prefer a recorded Arena score among comfortable fits; coverage is partial.
// Fall back to the existing size-ordered list when no scored fit is available.
const topPick =
  [...fitting]
    .filter((r) => r.result.verdict === "yes" && r.model.arena_elo != null)
    .sort((a, b) => (b.model.arena_elo ?? 0) - (a.model.arena_elo ?? 0))[0] ??
  fitting.find((r) => r.result.speed === "fast" || r.result.speed === "ok") ??
  fitting[0];

const setupPick = [topPick, ...fitting].find((row) => row && supportsSetupModel(row.model) && row.result.verdict === "yes" && (row.model.default_context_k ?? 0) >= 4);
const selectionIds: Record<string, string[]> = {
  "nvidia-rtx-2060-6gb": ["qwen3-4b", "qwen3-8b"],
  "apple-m5-pro-48gb": ["qwen3-14b", "qwen3-32b"],
};
const selection = (selectionIds[device.id] ?? []).map((id) => {
  const model = modelsBySize.find((model) => model.id === id);
  if (!model) throw new Error(`Hardware selection model missing: ${id}`);
  return { model, short: estimateMemory(model, "q4_k_m", 4), long: estimateMemory(model, "q4_k_m", 16), result: canRun(model, device, 4) };
});

// Nearby devices for lateral navigation: the closest usable-memory peers in the
// same broad class (computers vs phones/tablets), so "similar GB, similar story"
// holds and a Mac's neighbours are not iPhones. Proximity is ranked on the cheap
// usableGb figure first; only the shortlisted six pay for a full runnable-count pass.
const isMobileDevice = device.category === "iphone" || device.category === "android";
const nearby = devices
  .filter(
    (d) => d.id !== device.id && (d.category === "iphone" || d.category === "android") === isMobileDevice,
  )
  .map((d) => ({ d, u: usableGb(d) }))
  .sort((a, b) => Math.abs(a.u - usable) - Math.abs(b.u - usable))
  .slice(0, 6)
  .map(({ d, u }) => ({
    d,
    u,
    runs: modelsBySize.filter((m) => canRun(m, d).verdict !== "no").length,
  }))
  .sort((a, b) => b.u - a.u);

const path = `/best-llm-for/${device.id}`;
const year = new Date(meta.updated).getFullYear();
const title = `Best local LLMs for ${device.name} (${year}) · localmodel.run`;
const description = truncate(
  `${device.name} has ~${usable} GB usable; ${fitting.length} of ${ranked.length} tracked models fit the estimated memory budget.${topPick ? ` Suggested fit: ${topPick.model.name}.` : ""} Best tool: ${tool?.beginner.name ?? "Ollama"}. Ranked list with sizes and commands.`,
);

const faqs: FaqItem[] = [
  {
    q: `What is the best local LLM for ${device.name}?`,
    a: topPick
      ? `${topPick.model.name} is a suggested fit, using ~${topPick.result.estimate?.totalGb} GB at ${topPick.result.quant ? QUANT_LABEL[topPick.result.quant] : "Q4_K_M"} of the ~${usable} GB usable on ${device.name}.`
      : `${device.name} has limited memory; stick to 1B-4B models at Q4_K_M.`,
  },
  {
    q: `How much of ${device.name}'s memory can I use for a model?`,
    a: `About ${usable} GB. ${device.memory_type === "unified" && device.category === "mac" ? "Apple Silicon shares one unified memory pool; roughly 66-75% is available to the GPU for model weights, the rest is reserved for macOS." : device.memory_type === "unified" ? "CPU and GPU share one memory pool; the rest stays with the operating system." : device.memory_type === "vram" ? "On a discrete GPU, leave ~1 GB of VRAM for the driver and display." : "On a CPU-only machine, leave headroom for the OS and apps."}`,
  },
  {
    q: `Which tool should I use on ${platformLabel(platform)}?`,
    a: tool ? `${tool.beginner.name} (${tool.beginner.why}) or ${tool.power.name} for speed. ${tool.gotcha}` : "Ollama or LM Studio.",
  },
];

const sources = dedupeSources(device.sources, tool?.sources ?? [], topPick?.model.sources ?? [], ...selection.map((row) => row.model.sources));
const jsonLd = [
  breadcrumbLd(
    [
      { name: "Home", url: "/" },
      { name: "Devices", url: "/best-llm-for" },
      { name: device.name, url: path },
    ],
    Astro.site!.href,
  ),
  techArticleLd({
    headline: `Best local LLMs for ${device.name}`,
    description,
    url: path,
    origin: Astro.site!.href,
    dateModified: meta.updated,
    datePublished: meta.launched,
    sources,
    speakableSelector: [".verdict-text"],
  }),
  itemListLd({
    name: `Local LLMs ranked for ${device.name}`,
    items: fitting.map((r) => ({ name: r.model.name, url: `/can-i-run/${r.model.id}/${device.id}` })),
    origin: Astro.site!.href,
  }),
  faqLd(faqs),
  ...(topPick
    ? [
        howToLd({
          name: `How to run a local LLM on ${device.name}`,
          description: `Install a runtime, pick a model that fits ${device.name}'s ~${usable} GB usable memory, and run it locally.`,
          url: path,
          origin: Astro.site!.href,
          steps: [
            {
              name: `Install ${tool?.beginner.name ?? "Ollama"}`,
              text: `Install ${tool?.beginner.name ?? "Ollama"} on ${platformLabel(platform)}.${tool?.beginner.why ? ` ${tool.beginner.why}.` : ""} It downloads model weights for you and runs them from one command.`,
            },
            {
              name: "Pick a model that fits",
              text: `${device.name} has about ${usable} GB usable for a model. ${topPick.model.name} is a suggested fit, using ~${topPick.result.estimate?.totalGb} GB at ${topPick.result.quant ? QUANT_LABEL[topPick.result.quant] : "Q4_K_M"}. Stay under ~${usable} GB.`,
            },
            {
              name: `Run ${topPick.model.name}`,
              text: topPick.model.ollama_tag
                ? `Run "ollama run ${topPick.model.ollama_tag}" in a terminal. The weights download once, then a local chat session starts. Everything stays on ${device.name}.`
                : `Load ${topPick.model.name} in ${tool?.beginner.name ?? "your runtime"} and start a local chat session. Everything stays on ${device.name}.`,
            },
          ],
        }),
      ]
    : []),
];
---

<Base title={title} description={description} path={path} jsonLd={jsonLd} ogImage={`/og/rig/${device.id}.png`} mdPath={`/best-llm-for/${device.id}.md`} ogTitle={`Best local LLMs for ${device.name}`} ogType="article" articleModified={meta.updated} ogImageAlt={`Best local LLMs for ${device.name} ranked by compatibility`}>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <Breadcrumbs items={[{ name: "Home", url: "/" }, { name: "Devices", url: "/best-llm-for" }, { name: device.name, url: path }]} />

    <p class="eyebrow mt-4">
      <span class="dot" aria-hidden="true"></span>
      Device profile &middot; {platformLabel(platform)}
    </p>
    <h1 class="mt-3 flex items-center gap-3 text-balance text-3xl font-bold tracking-tight sm:text-4xl">
      <EntityIcon device={device.category} size={28} class="text-muted-foreground" />
      <span>Best local LLMs for {device.name}</span>
    </h1>
    <p class="mt-4 text-pretty text-lg text-muted-foreground">
      {device.name} has <strong class="num text-foreground">~{usable} GB</strong> estimated usable for weights, cache and runtime;
      <strong class="num text-foreground">{fitting.length}</strong> of <span class="num">{ranked.length}</span> tracked models fit at the estimated <span class="num">4K</span> baseline.
      {tool && <> Best tool: <strong class="text-foreground">{tool.beginner.name}</strong>.</>}
    </p>

    <!-- Fit distribution: how the tracked catalog splits on this device, scannable
         in one glance in the verdict palette (runs well / tight fit / too heavy). -->
    <div class="mt-5">
      <div
        class="flex h-3 w-full overflow-hidden rounded-[3px] border border-border"
        role="img"
        aria-label={`On ${device.name}: ${yesCount} estimated fits with room, ${tightCount} a tight fit, ${noCount} too heavy, of ${ranked.length} tracked models`}
      >
        {yesCount > 0 && <div style={`flex:${yesCount};background:var(--color-verdict-yes)`}></div>}
        {tightCount > 0 && <div style={`flex:${tightCount};background:var(--color-verdict-tight)`}></div>}
        {noCount > 0 && <div style={`flex:${noCount};background:var(--color-verdict-no)`}></div>}
      </div>
      <div class="mt-2.5 flex flex-wrap gap-x-5 gap-y-1.5 font-mono text-xs">
        <span class="inline-flex items-center gap-1.5"><span class="size-2 shrink-0 rounded-[1px]" style="background:var(--color-verdict-yes)"></span><b class="text-foreground">{yesCount}</b> <span class="text-muted-foreground">fit with room</span></span>
        <span class="inline-flex items-center gap-1.5"><span class="size-2 shrink-0 rounded-[1px]" style="background:var(--color-verdict-tight)"></span><b class="text-foreground">{tightCount}</b> <span class="text-muted-foreground">tight fit</span></span>
        <span class="inline-flex items-center gap-1.5"><span class="size-2 shrink-0 rounded-[1px]" style="background:var(--color-verdict-no)"></span><b class="text-foreground">{noCount}</b> <span class="text-muted-foreground">too heavy</span></span>
      </div>
    </div>

    <div class="wire mt-5" aria-hidden="true"></div>

    <dl class="stat-grid mt-4">
      <div class="stat">
        <dt class="stat-label">Usable memory</dt>
        <dd class="stat-val">~{usable} GB</dd>
      </div>
      <div class="stat">
        <dt class="stat-label">Estimated fits</dt>
        <dd class="stat-val">{fitting.length}</dd>
      </div>
      <div class="stat">
        <dt class="stat-label">Too large</dt>
        <dd class="stat-val">{notFitting.length}</dd>
      </div>
      {topPick && (
        <div class="stat">
          <dt class="stat-label">Suggested fit</dt>
          <dd class="stat-val stat-yes">{topPick.model.params_b}B</dd>
        </div>
      )}
    </dl>

    {topPick && (
      <div class="panel mt-6">
        <div class="panel-head">
          <span class="panel-label">Suggested fit</span>
          <span class="panel-label">{topPick.result.quant ? QUANT_LABEL[topPick.result.quant] : "Q4_K_M"}</span>
        </div>
        <div class="p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <a href={`/can-i-run/${topPick.model.id}/${device.id}`} class="text-xl font-bold hover:underline">{topPick.model.name}</a>
            <VerdictBadge verdict={topPick.result.verdict} />
          </div>
          <p class="verdict-text mt-1 text-sm text-muted-foreground">{topPick.result.reason}</p>
        </div>
      </div>
    )}

    <p class="mt-3 text-sm text-muted-foreground">The suggested model uses recorded Arena scores where available, then estimated fit and speed. Score coverage is partial; it does not establish the best model for every task. Fit is an estimate, not a benchmark on this device.</p>
    {setupPick && <p class="mt-3"><a href={setupHref({ deviceId: device.id, modelId: setupPick.model.id, contextK: 4 })} class="cta-link">Set up {setupPick.model.name} on this device &rarr;</a></p>}

    {selection.length > 0 && (
      <section id="choose-model" class="mt-8" aria-labelledby="selection-heading">
        <h2 id="selection-heading" class="text-xl font-semibold">Choose a model before downloading</h2>
        <p class="mt-2 text-sm text-muted-foreground">{device.memory_type === "vram"
          ? <>The <span class="num">{device.memory_gb} GB</span> VRAM pool leaves an estimated <span class="num">{usable} GB</span> after display and driver headroom. Start with Qwen3 4B; Qwen3 8B exceeds this GPU budget even before a longer conversation.</>
          : <>The <span class="num">{device.memory_gb} GB</span> unified pool has an estimated <span class="num">{usable} GB</span> available to the model. Qwen3 14B leaves more room for other apps; Qwen3 32B is a larger option when you can spare the memory.</>}
        </p>
        <div class="panel mt-4 overflow-x-auto">
          <table class="w-full text-left text-sm">
            <caption class="px-4 py-3 text-left text-muted-foreground">Estimated Q4_K_M memory: weights + KV cache + runtime overhead. Context is the total token budget.</caption>
            <thead><tr class="border-b border-border"><th scope="col" class="p-3">Model</th><th scope="col" class="p-3"><span class="num">4K</span> calculation (GB)</th><th scope="col" class="p-3"><span class="num">16K</span> total (GB)</th><th scope="col" class="p-3"><span class="num">4K</span> headroom (GB)</th></tr></thead>
            <tbody>{selection.map((row) => <tr class="border-b border-border last:border-0">
              <th scope="row" class="p-3 font-medium"><a href={`/can-i-run/${row.model.id}/${device.id}`} class="text-[var(--brand-ink)] hover:underline">{row.model.name}</a></th>
              <td class="num whitespace-nowrap p-3">{row.short.weightsGb} + {row.short.kvGb} + {row.short.overheadGb} ≈ {row.short.totalGb}</td>
              <td class="num p-3">{row.long.totalGb}</td>
              <td class="num p-3">{row.result.headroomGb}</td>
            </tr>)}</tbody>
          </table>
        </div>
        <p class="mt-3 text-sm text-muted-foreground">These are calculator estimates, not measured performance or tested setups. More context raises KV-cache use. Start at <span class="num">4K</span>, check actual runtime memory, and increase only with spare headroom. See the <a href="/methodology" class="underline">memory assumptions</a>.</p>
        <a href={setupHref({ deviceId: device.id, modelId: selection[0].model.id, contextK: 4 })} class="cta-link mt-3 inline-block">Set up {selection[0].model.name} at <span class="num">4K</span> &rarr;</a>
      </section>
    )}

    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold">Estimated memory fits on {device.name}</h2>
      <div class="panel overflow-hidden">
        <div class="panel-head">
          <span class="panel-label">Compatible models</span>
          <span class="panel-label">{fitting.length} total</span>
        </div>
        <ul class="divide-y divide-border">
          {fitting.map((r) => (
            <li>
              <a href={`/can-i-run/${r.model.id}/${device.id}`} class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-[color-mix(in_oklch,var(--color-brand)_6%,transparent)]">
                <EntityIcon maker={r.model.family} size={18} class="text-muted-foreground shrink-0" />
                <div class="min-w-0 flex-1">
                  <div class="truncate text-sm font-medium">{r.model.name}</div>
                  <div class="stat-label mt-0.5">{r.model.params_b}B{r.model.is_moe ? ` MoE` : ""} &middot; ~{r.result.estimate?.totalGb} GB at {r.result.quant ? QUANT_LABEL[r.result.quant] : "Q4_K_M"}</div>
                </div>
                <VerdictBadge verdict={r.result.verdict} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {notFitting.length > 0 && (
      <section class="mt-8">
        <h2 class="section-label mb-3">Too large for this device</h2>
        <div class="flex flex-wrap gap-2">
          {notFitting.map((r) => (
            <a href={`/can-i-run/${r.model.id}/${device.id}`} class="rounded-[3px] border border-border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:border-[color-mix(in_oklch,var(--color-brand)_45%,transparent)] hover:text-foreground">{r.model.name}</a>
          ))}
        </div>
      </section>
    )}

    {tool && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-semibold">Best way to run models on {platformLabel(platform)}</h2>
        <div class="panel">
          <div class="panel-head">
            <span class="panel-label">Runtime guide</span>
            <span class="panel-label">{platformLabel(platform)}</span>
          </div>
          <div class="p-4 space-y-2">
            <p class="text-sm text-muted-foreground"><strong class="text-foreground">Beginner:</strong> {tool.beginner.name}, {tool.beginner.why}</p>
            <p class="text-sm text-muted-foreground"><strong class="text-foreground">Power user:</strong> {tool.power.name}, {tool.power.why}</p>
            <p class="text-sm text-muted-foreground">{tool.gotcha}</p>
            <a href={`/tools#${platform}`} class="inline-block text-sm text-[var(--brand-ink)] hover:underline">Full {platformLabel(platform)} tool guide &rarr;</a>
          </div>
        </div>
      </section>
    )}

    <section class="mt-10">
      <h2 class="mb-3 text-lg font-semibold">FAQ</h2>
      <div class="panel divide-y divide-border">
        {faqs.map((f) => (
          <div class="p-4">
            <p class="font-medium">{f.q}</p>
            <p class="mt-2 text-sm text-muted-foreground">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    {nearby.length > 0 && (
      <section class="mt-8" aria-labelledby="nearby-heading">
        <h2 id="nearby-heading" class="mb-1 text-lg font-semibold">Compare nearby devices</h2>
        <p class="mb-3 text-sm text-muted-foreground">
          Hardware with a similar usable pool, and how many of the {ranked.length} tracked models each
          runs next to {device.name}'s {fitting.length}.
        </p>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {nearby.map((n) => {
            const delta = n.runs - fitting.length;
            const deltaLabel =
              delta === 0
                ? `Runs the same number of models as ${device.name}`
                : `Runs ${Math.abs(delta)} ${delta > 0 ? "more" : "fewer"} models than ${device.name}`;
            return (
              <a
                href={`/best-llm-for/${n.d.id}`}
                class="panel card-seam group flex items-center gap-3 px-4 py-3 transition-colors hover:border-[color-mix(in_oklch,var(--color-brand)_45%,transparent)]"
              >
                <EntityIcon device={n.d.category} size={18} class="shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                  <div class="truncate text-sm font-medium">{n.d.name}</div>
                  <div class="stat-label mt-0.5">~{n.u} GB usable &middot; runs {n.runs} of {ranked.length}</div>
                </div>
                <span
                  class="shrink-0 font-mono text-xs text-muted-foreground"
                  aria-label={deltaLabel}
                >
                  {delta > 0 ? `+${delta}` : delta < 0 ? `${delta}` : "="}
                </span>
              </a>
            );
          })}
        </div>
        <nav class="mt-4 flex flex-wrap gap-2" aria-label="More devices">
          <a
            href="/best-llm-for"
            class="rounded-[3px] border border-border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:border-[color-mix(in_oklch,var(--color-brand)_45%,transparent)] hover:text-foreground"
          >
            Browse all devices &rarr;
          </a>
          <a
            href={`/rig/${device.id}`}
            class="rounded-[3px] border border-border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:border-[color-mix(in_oklch,var(--color-brand)_45%,transparent)] hover:text-foreground"
          >
            {device.name} rig score &rarr;
          </a>
        </nav>
      </section>
    )}

    <Sources urls={sources} />

    <p class="mt-6 text-xs text-muted-foreground">
      Memory figures are estimates. See <a href="/methodology" class="underline">methodology</a>.
    </p>
  </div>
</Base>
