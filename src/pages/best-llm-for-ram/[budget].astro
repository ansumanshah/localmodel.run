---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import VerdictBadge from "@/components/VerdictBadge.astro";
import EntityIcon from "@/components/EntityIcon.astro";
import Sources from "@/components/Sources.astro";
import { devices, modelsBySize, dedupeSources, getModel, meta } from "@/lib/data";
import { canRun, estimateMemory } from "@/lib/compute";
import { setupModels, type SetupTask } from "@/lib/setup";
import { setupHref } from "@/lib/setup-link";
import type { DeviceRow, ModelRow } from "@/data/types";
import { BUDGETS, desktopDevicesAt, interpretationsFor, TYPE_LABEL, TYPE_SHORT, type Interp } from "@/lib/budgets";
import {
  breadcrumbLd,
  faqLd,
  itemListLd,
  techArticleLd,
  truncate,
  type FaqItem,
} from "@/lib/seo";

// RAM-budget pages answer "what LLM fits in N GB?" The honest answer is that
// N GB is not one number: a 16 GB Mac, a 16 GB GPU and a 16 GB CPU laptop each
// expose a different usable pool. So every budget is anchored to REAL, sourced
// devices at that exact size (one per memory type, via @/lib/budgets), and every
// model is verdicted against each interpretation through the same canRun() engine
// the rest of the site uses. No synthesized "usable fraction" anywhere.

export function getStaticPaths() {
  // Inlined (not BUDGETS) because Astro evaluates getStaticPaths in an isolated
  // scope that does not close over imported/module-level bindings.
  return [6, 8, 12, 16, 24, 32, 48, 64, 128, 256].map((gb) => ({ params: { budget: `${gb}gb` }, props: { gb } }));
}

const { gb } = Astro.props as { gb: number };

// Phones get a separate aside (different runtime story) so the primary
// interpretations stay apples-to-apples desktop/laptop classes.
const interps = interpretationsFor(gb);
// Reduce over the LOCAL interps array so the result is one of these instances
// (later code compares interp identity by reference).
const mostGenerous = interps.reduce((a, b) => (b.usable > a.usable ? b : a), interps[0]);
const allAtSize = desktopDevicesAt(gb);
const phones = devices.filter(
  (d) => d.memory_gb === gb && (d.category === "iphone" || d.category === "android"),
);

interface Row {
  model: ModelRow;
  verdicts: { interp: Interp; result: ReturnType<typeof canRun> }[];
  fits: boolean;
  q4Gb: number | null;
}

const rows: Row[] = modelsBySize.map((model) => {
  const verdicts = interps.map((interp) => ({ interp, result: canRun(model, interp.device) }));
  const fits = verdicts.some((v) => v.result.verdict !== "no");
  const q4 = verdicts[0]?.result.estimate?.totalGb ?? null;
  return { model, verdicts, fits, q4Gb: q4 };
});

// Parameter count orders memory ceilings, not model quality.
const fitting = rows.filter((r) => r.fits).sort((a, b) => b.model.params_b - a.model.params_b);
const tooLarge = rows.filter((r) => !r.fits).sort((a, b) => a.model.params_b - b.model.params_b);

// Largest comfortably-running ("yes") model per interpretation = its ceiling.
function ceilingFor(device: DeviceRow): ModelRow | null {
  let best: ModelRow | null = null;
  for (const m of modelsBySize) if (canRun(m, device).verdict === "yes") best = m;
  return best;
}
const ceilings = interps.map((i) => ({ interp: i, model: ceilingFor(i.device) }));

// Largest comfortable fit on the most generous reading, not a quality ranking.
const largestFit =
  fitting.find((r) => {
    const v = r.verdicts.find((x) => x.interp === mostGenerous);
    return v?.result.verdict === "yes";
  });

const tasks: { task: SetupTask; label: string }[] = [
  { task: "chat", label: "Chat and writing" },
  { task: "coding", label: "Coding" },
  { task: "reasoning", label: "Math and reasoning" },
];
const starters = gb === 16 ? interps.map((interp) => ({
  interp,
  choices: tasks.flatMap(({ task, label }) => {
    const pick = setupModels(interp.device, task, 4)[0];
    return pick ? [{ task, label, ...pick }] : [];
  }),
})) : [];
const contextModel = gb === 16 ? getModel("qwen2.5-coder-14b") : undefined;
if (gb === 16 && !contextModel) throw new Error("16GB guide: context example model is missing");
const contextExamples = contextModel ? [4, 16].map((contextK) => ({
  contextK,
  estimate: estimateMemory(contextModel, "q4_k_m", contextK),
  verdicts: interps.map((interp) => ({ interp, result: canRun(contextModel, interp.device, contextK) })),
})) : [];

const usableList = interps.map((i) => `~${i.usable} GB on ${TYPE_SHORT[i.type]}`).join(", ");
// Phrases built from the memory types that ACTUALLY exist at this size (some
// budgets have no GPU or no laptop entry), so copy never claims a type the page
// does not show.
const hasGpu = interps.some((i) => i.type === "vram");
const typesSlash = interps.map((i) => TYPE_SHORT[i.type]).join(" / ");
// "an 8GB" (eight starts with a vowel sound), "a 16GB" otherwise.
const article = /^(8|11|18)/.test(String(gb)) ? "an" : "a";
const typeNouns = interps.map((i) => `${article} ${gb}GB ${TYPE_SHORT[i.type]}`);
const typesPhrase =
  typeNouns.length > 1
    ? `${typeNouns.slice(0, -1).join(", ")} and ${typeNouns[typeNouns.length - 1]}`
    : typeNouns[0];
const path = `/best-llm-for-ram/${gb}gb`;
const year = new Date(meta.updated).getFullYear();
const headline = gb === 16 ? "Best local LLMs for 16GB RAM and VRAM" : `Best local LLMs for ${gb}GB`;
const title = `${headline} (${year}) · localmodel.run`;
const description = truncate(
  gb === 16
    ? "Choose a local LLM for 16GB RAM, a Mac or a 16GB GPU. Compare chat, coding and reasoning starters, Q4 memory at 4K and 16K context, and setup steps."
    : interps.length > 1
    ? `${gb}GB is not one number: ${usableList} usable. See which of ${rows.length} local LLMs fit ${gb}GB, ranked by size with a ${typesSlash} verdict each.`
    : `${fitting.length} of ${rows.length} local LLMs fit ${gb}GB: ${usableList} usable on the ${mostGenerous.device.name}. Ranked by size, with a verdict for each.`,
);

const faqs: FaqItem[] = [
  {
    q: `How much of ${gb}GB can a model actually use?`,
    a: `It depends on the memory type. ${interps
      .map((i) => `${TYPE_LABEL[i.type]}: about ${i.usable} GB (${i.device.name})`)
      .join("; ")}. The rest is reserved for the OS, display and runtime overhead.`,
  },
  {
    q: `What is the best local LLM for ${gb}GB?`,
    a: gb === 16
      ? "Choose for your task and memory type first. The starter lists below use recorded Ollama popularity among models estimated to fit comfortably at Q4_K_M and 4K context. They are starting points, not quality rankings or tested speed results. A 16GB Mac, CPU laptop and GPU have different usable budgets."
      : largestFit
      ? `${largestFit.model.name} (${largestFit.model.params_b}B) is the largest model by parameter count estimated to fit comfortably at Q4_K_M on the ${mostGenerous.device.name} (~${mostGenerous.usable} GB usable). This is a memory ceiling, not a quality recommendation. On a tighter ${gb}GB device the ceiling is lower.`
      : `At ${gb}GB, stick to the smallest models; see the ranked list above.`,
  },
  // Only when a GPU interpretation actually appears at this size (no 8 GB or
  // 24 GB consumer GPU exists in the dataset, so the premise would be false there).
  ...(hasGpu && interps.some((i) => i.type === "unified")
    ? [
        {
          q: `Why does a ${gb}GB GPU fit a bigger model than a ${gb}GB Mac?`,
          a: `A discrete GPU gives almost all of its VRAM to the model (leave ~1 GB for the driver). Apple Silicon shares one unified pool with macOS, so roughly 66% is available to the GPU for weights. Same ${gb}GB sticker, different usable budget, so the model ceiling differs.`,
        },
      ]
    : []),
  ...(gb === 16 ? [
    { q: "Can I run a local LLM on a 16GB laptop without a dedicated GPU?", a: "Yes, the CPU-only laptop examples below have estimated comfortable fits. That does not establish generation speed. Start at 4K context, keep other applications in mind, and use the setup guide to choose a smaller model if replies are too slow." },
    { q: "Does a model that fits at 4K context also fit at 16K?", a: "Not necessarily. The download size stays the same, but the KV cache grows with context. The worked example below shows estimated weights, cache and runtime overhead at both settings. Recheck your exact device before increasing context." },
  ] : []),
];

const sources = dedupeSources(
  ...interps.map((i) => i.device.sources),
  largestFit?.model.sources ?? [],
  ...starters.flatMap(({ choices }) => choices.map(({ model }) => model.sources)),
  contextModel?.sources ?? [],
);

const jsonLd = [
  breadcrumbLd(
    [
      { name: "Home", url: "/" },
      { name: "By memory", url: "/best-llm-for-ram" },
      { name: `${gb}GB`, url: path },
    ],
    Astro.site!.href,
  ),
  techArticleLd({
    headline,
    description,
    url: path,
    origin: Astro.site!.href,
    dateModified: meta.updated,
    datePublished: meta.launched,
    sources,
    speakableSelector: [".budget-lede"],
  }),
  itemListLd({
    name: `Local LLMs that fit in ${gb}GB`,
    items: fitting
      .slice(0, 25)
      .map((r) => ({ name: r.model.name, url: `/model/${r.model.id}` })),
    origin: Astro.site!.href,
  }),
  faqLd(faqs),
];
---

<Base
  title={title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  ogTitle={headline}
  ogType="article"
  articleModified={meta.updated}
  ogImageAlt={`Local LLMs that fit in ${gb}GB of memory, ranked`}
>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <Breadcrumbs
      items={[
        { name: "Home", url: "/" },
        { name: "By memory", url: "/best-llm-for-ram" },
        { name: `${gb}GB`, url: path },
      ]}
    />

    <p class="eyebrow mt-4">
      <span class="dot" aria-hidden="true"></span>
      Memory budget &middot; {gb} GB
    </p>
    <h1 class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-4xl">
      {headline}
    </h1>
    <p class="budget-lede mt-4 text-pretty text-lg text-muted-foreground">
      {gb === 16 ? (
        <>
          <span class="font-mono">16GB</span> leaves about {interps.map((interp, index) => (
            <>{index > 0 ? ", " : ""}<span class="font-mono">{interp.usable} GB</span> on {TYPE_SHORT[interp.type]}</>
          ))} usable in our representative memory budgets. Choose a starter for your task below, then check the
          model, context and runtime on your own device. These are memory estimates, not hardware test results.
        </>
      ) : interps.length > 1 ? (
        <>
          {gb}GB is not a single ceiling. {typesPhrase.charAt(0).toUpperCase() + typesPhrase.slice(1)} each
          leave a different amount free for model weights, so the largest model you can run changes with the
          memory <strong class="text-foreground">type</strong>, not just the number.
        </>
      ) : (
        <>
          The {mostGenerous.device.name} gives about <strong class="text-foreground">~{mostGenerous.usable} GB</strong> of its
          {gb}GB to model weights after {mostGenerous.type === "vram" ? "the driver and display take their share" : "the OS takes its share"}. {fitting.length} of {rows.length} local LLMs fit, biggest first.
        </>
      )}
    </p>

    <div class="wire mt-5" aria-hidden="true"></div>

    <dl class="stat-grid mt-4">
      <div class="stat">
        <dt class="stat-label">Usable range</dt>
        <dd class="stat-val">
          {Math.min(...interps.map((i) => i.usable))}{Math.max(...interps.map((i) => i.usable)) !== Math.min(...interps.map((i) => i.usable)) ? `–${Math.max(...interps.map((i) => i.usable))}` : ""} GB
        </dd>
      </div>
      <div class="stat">
        <dt class="stat-label">Models that fit</dt>
        <dd class="stat-val">{fitting.length}</dd>
      </div>
      <div class="stat">
        <dt class="stat-label">Memory types</dt>
        <dd class="stat-val">{interps.length}</dd>
      </div>
      {largestFit && (
        <div class="stat">
          <dt class="stat-label">Largest comfortable fit</dt>
          <dd class="stat-val stat-yes">{largestFit.model.params_b}B</dd>
        </div>
      )}
    </dl>

    {gb === 16 && (
      <>
        <nav class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm" aria-label="In this guide">
          <a href="#choose-model" class="underline">Choose by task</a>
          <a href="#context" class="underline">Context and memory</a>
          <a href="#setup" class="underline">Set it up</a>
          <a href="#models" class="underline">All models that fit</a>
        </nav>
        <section id="choose-model" class="mt-8 scroll-mt-20" aria-labelledby="choose-model-heading">
          <h2 id="choose-model-heading" class="text-xl font-semibold">Which local model should you try first?</h2>
          <p class="mt-3 text-sm text-muted-foreground">
            These starters reuse the setup guide's task filters and recorded Ollama popularity.
            Each has a measured Q4_K_M download and an estimated comfortable fit at <span class="font-mono">4K</span> context.
            Popularity and parameter count do not establish answer quality. Compare
            <a href="/leaderboard" class="underline">recorded benchmarks</a> separately.
          </p>
          <div class="mt-4 space-y-4">
            {starters.map(({ interp, choices }) => (
              <div class="panel p-4">
                <h3 class="text-xl font-semibold">{TYPE_LABEL[interp.type]}</h3>
                <p class="mt-1 text-sm text-muted-foreground">
                  <a href={`/best-llm-for/${interp.device.id}`} class="underline">{interp.device.name}</a>
                  {" · "}<span class="font-mono">~{interp.usable} GB</span> usable
                </p>
                <ul class="mt-3 divide-y divide-border">
                  {choices.map(({ task, label, model, result }) => (
                    <li class="flex flex-wrap items-center justify-between gap-3 py-3">
                      <div>
                        <p class="text-sm font-medium">{label}: <a href={`/model/${model.id}`} class="underline">{model.name}</a></p>
                        <p class="mt-1 text-sm text-muted-foreground">
                          <span class="font-mono">{model.q4_k_m_gb} GB</span> Q4 download ·
                          <span class="font-mono"> ~{result.estimate!.totalGb} GB</span> estimated memory ·
                          <span class="font-mono"> {result.headroomGb} GB</span> headroom
                        </p>
                      </div>
                      <a class="btn" href={setupHref({ deviceId: interp.device.id, modelId: model.id, task, contextK: 4 })}
                        aria-label={`Set up ${model.name} for ${label.toLowerCase()} on ${interp.device.name}`}>Set up this model →</a>
                    </li>
                  ))}
                  {choices.length === 0 && <li class="py-3 text-sm text-muted-foreground">No comfortable starter is recorded for this device. Try the <a href="/calculator" class="underline">fit calculator</a>.</li>}
                </ul>
                {interp.type === "ram" && <p class="mt-2 text-sm text-muted-foreground">CPU memory fit does not guarantee usable speed. If replies are too slow, try a smaller model in the setup guide.</p>}
              </div>
            ))}
          </div>
        </section>
        {contextModel && (
          <section id="context" class="mt-8 scroll-mt-20" aria-labelledby="context-heading">
            <h2 id="context-heading" class="text-xl font-semibold">Why context changes what fits in 16GB</h2>
            <p class="mt-3 text-sm text-muted-foreground">
              <a href={`/model/${contextModel.id}`} class="underline">{contextModel.name}</a> has a
              <span class="font-mono"> {contextModel.q4_k_m_gb} GB</span> Q4_K_M download. The download stays the same
              when you increase context, but the KV cache grows. The shared memory engine estimates:
            </p>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {contextExamples.map(({ contextK, estimate, verdicts }) => (
                <div class="panel p-4">
                  <h3 class="text-xl font-semibold"><span class="font-mono">{contextK}K</span> context</h3>
                  <p class="mt-2 text-sm text-muted-foreground">
                    <span class="font-mono">{estimate.weightsGb} GB</span> weights +
                    <span class="font-mono"> {estimate.kvGb} GB</span> KV cache +
                    <span class="font-mono"> {estimate.overheadGb} GB</span> runtime =
                    <strong class="font-mono text-foreground"> ~{estimate.totalGb} GB</strong>
                  </p>
                  <ul class="mt-3 space-y-2">
                    {verdicts.map(({ interp, result }) => (
                      <li class="flex items-center justify-between gap-2 text-sm">
                        <span>{TYPE_SHORT[interp.type]}</span><VerdictBadge verdict={result.verdict} />
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <p class="mt-3 text-sm text-muted-foreground">
              The device examples are the same ones named above. KV cache and runtime memory are estimates;
              actual use depends on the runtime and cache settings. Long documents and coding sessions need
              room for both input and output. Read the <a href="/methodology" class="underline">calculation method</a>
              or check another configuration in the <a href="/calculator" class="underline">calculator</a>.
            </p>
          </section>
        )}
        <section id="setup" class="mt-8 scroll-mt-20" aria-labelledby="setup-heading">
          <h2 id="setup-heading" class="text-xl font-semibold">Run your first model on a 16GB machine</h2>
          <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-muted-foreground">
            <li>Use a starter's setup link to carry its device, model, task and <span class="font-mono">4K</span> context into the guide. Change the representative device to your actual hardware if needed.</li>
            <li>Follow the <a href="/tools" class="underline">runtime instructions</a>, download the linked Q4_K_M GGUF and set the same context window. A different quantization or context needs another fit check.</li>
            <li>Try one real task. If it runs out of memory, lower context or choose a smaller model. Report whether it worked in the setup guide.</li>
          </ol>
          <p class="mt-3 text-sm text-muted-foreground">These configurations have not been inference-tested here. No tokens-per-second or task-quality result is claimed.</p>
        </section>
      </>
    )}

    <!-- What N GB means: the unique-math centerpiece, anchored to real devices -->
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold">What {gb}GB actually gives you</h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        {interps.map((i) => (
          <a
            href={`/best-llm-for/${i.device.id}`}
            class="panel card-seam group flex flex-col gap-1 px-4 py-3 transition-colors hover:border-[color-mix(in_oklch,var(--color-brand)_45%,transparent)]"
          >
            <span class="stat-label">{TYPE_LABEL[i.type]}</span>
            <span class="text-2xl font-bold tracking-tight">~{i.usable} GB</span>
            <span class="text-xs text-muted-foreground">
              usable on {i.device.name}
            </span>
            {ceilings.find((c) => c.interp === i)?.model && (
              <span class="mt-1 text-xs text-muted-foreground">
                Comfortable ceiling: <strong class="text-foreground">{ceilings.find((c) => c.interp === i)!.model!.params_b}B</strong>
              </span>
            )}
          </a>
        ))}
      </div>
      <p class="mt-2 text-xs text-muted-foreground">
        Usable figures are sourced per device (tap a card for the full profile). Verdicts below use
        Q4_K_M, the community-default quant.
      </p>
    </section>

    {allAtSize.length > 1 && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-semibold">Every tracked {gb}GB device</h2>
        <div class="panel overflow-hidden">
          <div class="panel-head">
            <span class="panel-label">Most usable memory first</span>
            <span class="panel-label">Sourced specs</span>
          </div>
          <ul class="divide-y divide-border">
            {allAtSize.map((d) => (
              <li class="px-4 py-3">
                <a href={`/best-llm-for/${d.id}`} class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 hover:underline">
                  <span class="flex items-center gap-2 text-sm font-medium">
                    <EntityIcon device={d.category} size={14} class="shrink-0 text-muted-foreground" />
                    {d.name}
                  </span>
                  <span class="stat-label">
                    ~{d.usable_memory_gb} GB usable
                    {d.bandwidth_gbs ? <> &middot; {d.bandwidth_gbs} GB/s</> : null}
                    {d.best_runtime ? <> &middot; {d.best_runtime}</> : null}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <p class="mt-2 text-xs text-muted-foreground">
          Each device has its own profile with the full ranked list. Memory bandwidth, where listed,
          sets how fast tokens generate; it does not change what fits.
        </p>
      </section>
    )}

    {largestFit && (
      <div class="panel mt-8">
        <div class="panel-head">
          <span class="panel-label">Largest comfortable fit for {gb}GB</span>
          <span class="panel-label">Q4_K_M</span>
        </div>
        <div class="p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <a href={`/model/${largestFit.model.id}`} class="text-xl font-bold hover:underline">
              {largestFit.model.name}
            </a>
            <span class="stat-label">{largestFit.model.params_b}B{largestFit.model.is_moe ? " MoE" : ""}</span>
          </div>
          <p class="mt-1 text-sm text-muted-foreground">
            Estimated to fit comfortably on {mostGenerous.device.name} (~{mostGenerous.usable} GB usable)
            at ~{largestFit.q4Gb} GB with Q4_K_M and 4K context. This is the largest by parameter count,
            not a quality or speed recommendation. Check your exact device on its
            <a href={`/model/${largestFit.model.id}`} class="underline">model page</a>.
          </p>
        </div>
      </div>
    )}

    <!-- Ranked fit matrix: one verdict per memory-type interpretation -->
    <section id="models" class="mt-8 scroll-mt-20">
      <h2 class="mb-3 text-lg font-semibold">Models ranked for {gb}GB</h2>
      <div class="panel overflow-hidden">
        <div class="panel-head">
          <span class="panel-label">Biggest that fits first</span>
          <span class="panel-label">{interps.map((i) => TYPE_SHORT[i.type]).join(" · ")}</span>
        </div>
        <ul class="divide-y divide-border">
          {fitting.map((r) => (
            <li class="px-4 py-3">
              <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
                <div class="min-w-0 flex items-center gap-3">
                  <EntityIcon maker={r.model.family} size={18} class="text-muted-foreground shrink-0" />
                  <div class="min-w-0">
                    <a href={`/model/${r.model.id}`} class="block truncate text-sm font-medium hover:underline">
                      {r.model.name}
                    </a>
                    <div class="stat-label mt-0.5">
                      {r.model.params_b}B{r.model.is_moe ? " MoE" : ""} &middot; ~{r.q4Gb} GB at Q4_K_M
                      {r.model.arena_elo ? <> &middot; Elo {r.model.arena_elo}</> : null}
                    </div>
                  </div>
                </div>
                <div class="flex flex-wrap items-center gap-1.5">
                  {r.verdicts.map((v) => (
                    <a
                      href={`/can-i-run/${r.model.id}/${v.interp.device.id}`}
                      class="inline-flex items-center gap-1 rounded-[3px] border border-border px-1.5 py-0.5 transition-colors hover:border-[color-mix(in_oklch,var(--color-brand)_45%,transparent)]"
                      aria-label={`${r.model.name} on a ${gb}GB ${TYPE_SHORT[v.interp.type]}: ${v.result.verdict}`}
                    >
                      <span class="stat-label">{TYPE_SHORT[v.interp.type]}</span>
                      <VerdictBadge verdict={v.result.verdict} />
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-2 text-xs text-muted-foreground">
        Each chip links to the full breakdown for that model on a real {gb}GB device. "Tight" means
        it fits but with little headroom, close other apps.
      </p>
    </section>

    <!-- Per-interpretation ceiling narrative (hand-framed, data-filled) -->
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold">The ceiling, per memory type</h2>
      <div class="panel divide-y divide-border">
        {ceilings.map(({ interp, model }) => (
          <div class="p-4">
            <p class="font-medium">{interp.device.name} <span class="text-muted-foreground">(~{interp.usable} GB usable)</span></p>
            <p class="mt-1 text-sm text-muted-foreground">
              {model ? (
                <>Runs up to <a href={`/can-i-run/${model.id}/${interp.device.id}`} class="underline">{model.name}</a> ({model.params_b}B) comfortably at Q4_K_M. Larger models either sit tight or spill past the ~{interp.usable} GB it can give a model.</>
              ) : (
                <>Even the smallest tracked models are tight here; expect 1–3B class only.</>
              )}
            </p>
          </div>
        ))}
      </div>
    </section>

    {phones.length > 0 && (
      <section class="mt-8">
        <h2 class="section-label mb-3">{gb}GB phones &amp; tablets</h2>
        <p class="mb-3 text-sm text-muted-foreground">
          Phones report {gb}GB too, but iOS/Android reserve more and the runtimes differ. Their
          usable pool is smaller:
        </p>
        <div class="flex flex-wrap gap-2">
          {phones.map((d) => (
            <a
              href={`/best-llm-for/${d.id}`}
              class="inline-flex items-center gap-1.5 rounded-[3px] border border-border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:border-[color-mix(in_oklch,var(--color-brand)_45%,transparent)] hover:text-foreground"
            >
              <EntityIcon device={d.category} size={14} class="shrink-0" />
              {d.name} <span class="stat-label">~{d.usable_memory_gb} GB</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {tooLarge.length > 0 && (
      <section class="mt-8">
        <h2 class="section-label mb-3">Too large for any {gb}GB device</h2>
        <div class="flex flex-wrap gap-2">
          {tooLarge.map((r) => (
            <a
              href={`/model/${r.model.id}`}
              class="rounded-[3px] border border-border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:border-[color-mix(in_oklch,var(--color-brand)_45%,transparent)] hover:text-foreground"
            >
              {r.model.name} <span class="stat-label">{r.model.params_b}B</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mt-10">
      <h2 class="mb-3 text-lg font-semibold">FAQ</h2>
      <div class="panel divide-y divide-border">
        {faqs.map((f) => (
          <div class="p-4">
            <p class="font-medium">{f.q}</p>
            <p class="mt-2 text-sm text-muted-foreground">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <nav class="mt-8" aria-label="Other memory budgets">
      <h2 class="section-label mb-3">Other memory budgets</h2>
      <div class="flex flex-wrap gap-2">
        {BUDGETS.filter((b) => b !== gb).map((b) => (
          <a
            href={`/best-llm-for-ram/${b}gb`}
            class="rounded-[3px] border border-border px-3 py-1.5 text-sm font-medium transition-colors hover:border-[color-mix(in_oklch,var(--color-brand)_45%,transparent)]"
          >
            {b}GB
          </a>
        ))}
        <a
          href="/best-llm-for"
          class="rounded-[3px] border border-border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:border-[color-mix(in_oklch,var(--color-brand)_45%,transparent)] hover:text-foreground"
        >
          Browse by device →
        </a>
      </div>
    </nav>

    <Sources urls={sources} />

    <p class="mt-6 text-xs text-muted-foreground">
      Memory figures are estimates at Q4_K_M with 4K context unless stated otherwise. See
      <a href="/methodology" class="underline">methodology</a>.
    </p>
  </div>
</Base>
