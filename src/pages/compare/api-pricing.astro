---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { estimateApiCost, formatApiCost, isApiPriceCurrent } from "@/lib/api-cost";
import { hostedModels } from "@/lib/hosted-models";
import { breadcrumbLd, faqLd, itemListLd, techArticleLd, truncate, type FaqItem } from "@/lib/seo";

const path = "/compare/api-pricing";
const pageDate = "2026-09-22";
const inputMillion = 1;
const outputMillion = 0.2;
const providers = [...new Set(hostedModels.map((model) => model.provider))].sort();
const models = [...hostedModels].sort((a, b) => a.provider.localeCompare(b.provider) || a.name.localeCompare(b.name));
const pricedModels = models.filter((model) => model.pricing && isApiPriceCurrent(model.pricing));
const modifiedDate = [pageDate, ...models.flatMap((model) => model.pricing ? [model.pricing.verifiedAt] : [model.verifiedAt])].sort().at(-1)!;
const costs = pricedModels.flatMap((model) => {
  const cost = estimateApiCost(model.pricing, inputMillion, outputMillion);
  return cost == null ? [] : [cost];
});
const costRange = costs.length ? `${formatApiCost(Math.min(...costs))} to ${formatApiCost(Math.max(...costs))}` : "Unavailable";
const title = "AI API pricing calculator and hosted model directory · localmodel.run";
const description = truncate(`Compare dated, vendor-sourced token prices for ${models.length} hosted AI models. Estimate monthly API cost from input and output token volumes, then check which models have no local weights.`);
const faqs: FaqItem[] = [
  { q: "Is this an API bill quote?", a: "No. Each estimate multiplies entered monthly input and billed output tokens by the linked vendor rate. It excludes subscriptions, tools, cache writes, discounts, taxes and request-length surcharges." },
  { q: "Can I run these hosted models locally?", a: "No. This directory marks models that are offered through a provider API. Use the local catalog to check open-weight models against your hardware." },
  { q: "Why is a price unavailable?", a: "A model has no listed standard token rate, or its listed rate has expired. Follow the provider price link for the current service terms." },
];
const jsonLd = [
  breadcrumbLd([{ name: "Home", url: "/" }, { name: "Compare", url: "/compare" }, { name: "API pricing", url: path }], Astro.site!.href),
  techArticleLd({ headline: "AI API pricing calculator and hosted model directory", description, url: path, origin: Astro.site!.href, datePublished: pageDate, dateModified: modifiedDate, sources: pricedModels.flatMap((model) => model.pricing ? [model.pricing.sourceUrl] : []), speakableSelector: [".api-pricing-answer"] }),
  itemListLd({ name: "Hosted AI model directory", items: models.map((model) => ({ name: model.name, url: model.sourceUrl })), origin: Astro.site!.href }),
  faqLd(faqs),
];
const pricingData = (pricing: unknown) => pricing ? JSON.stringify(pricing).replace(/</g, "\\u003c") : "";
---

<Base title={title} description={description} path={path} jsonLd={jsonLd} ogType="article" articleModified={modifiedDate} ogTitle="AI API pricing calculator">
  <article class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumbs items={[{ name: "Home", url: "/" }, { name: "Compare", url: "/compare" }, { name: "API pricing", url: path }]} />

    <div class="max-w-3xl">
      <p class="eyebrow mt-4"><span class="dot" aria-hidden="true"></span>Hosted model directory</p>
      <h1 class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-4xl">AI API pricing calculator</h1>
      <p class="api-pricing-answer mt-4 text-pretty text-lg text-muted-foreground"><strong class="text-foreground">At <span class="num">1.0M</span> input and <span class="num">0.2M</span> billed output tokens per month, listed current rates range from <span class="num">{costRange}</span>.</strong> Compare dated vendor rates for hosted models, then decide whether an API or a local model fits your work.</p>
    </div>

    <api-pricing-catalog class="block mt-8">
      <section class="panel p-4 sm:p-5" aria-labelledby="api-pricing-controls-heading">
        <div class="max-w-2xl"><p class="eyebrow"><span class="dot" aria-hidden="true"></span>Usage estimate</p><h2 id="api-pricing-controls-heading" class="mt-1 text-xl font-semibold">Estimate monthly token spend</h2><p class="mt-2 text-sm text-muted-foreground">Enter tokens in millions. The directory stays fully readable without JavaScript.</p></div>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          <label class="block text-sm font-medium" for="api-pricing-input">Monthly input tokens <span class="text-muted-foreground">(millions)</span><input id="api-pricing-input" class="field mt-1 block w-full" type="number" inputmode="decimal" min="0" max="1000000" step="any" value={inputMillion} /></label>
          <label class="block text-sm font-medium" for="api-pricing-output">Monthly billed output tokens <span class="text-muted-foreground">(millions)</span><input id="api-pricing-output" class="field mt-1 block w-full" type="number" inputmode="decimal" min="0" max="1000000" step="any" value={outputMillion} /></label>
          <label class="block text-sm font-medium" for="api-pricing-provider">Provider<select id="api-pricing-provider" class="field mt-1 block w-full"><option value="all">All providers</option>{providers.map((provider) => <option value={provider}>{provider}</option>)}</select></label>
        </div>
        <p id="api-pricing-summary" class="mt-4 text-sm text-muted-foreground" aria-live="polite">Showing {models.length} hosted models.</p>
        <p id="api-pricing-note" class="mt-2 text-xs text-muted-foreground" aria-live="polite">Estimates use uncached standard input and billed output rates. They exclude cache writes, tools, subscriptions, discounts, taxes and request-length surcharges. Expired rates are unavailable.</p>
      </section>

      <section class="mt-8" aria-labelledby="api-pricing-directory-heading">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Vendor-sourced rates</p>
        <h2 id="api-pricing-directory-heading" class="mt-1 text-xl font-semibold">Hosted models and listed API rates</h2>
        <p class="mt-2 text-xs text-muted-foreground lg:hidden">Scroll sideways to view all rate columns.</p>
        <div class="panel mt-3 overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable hosted model pricing directory">
          <table class="api-pricing-table w-full text-left">
            <caption class="sr-only">Hosted models with provider model IDs, API rates, verification dates and monthly estimates.</caption>
            <thead><tr><th scope="col">Model</th><th scope="col">API access</th><th scope="col">Input rate</th><th scope="col">Output rate</th><th scope="col">Monthly estimate</th></tr></thead>
            <tbody>{models.map((model) => {
              const price = model.pricing;
              const current = price && isApiPriceCurrent(price);
              const cost = current ? estimateApiCost(price, inputMillion, outputMillion) : null;
              return <tr data-api-pricing-row data-provider={model.provider} data-pricing={pricingData(current ? price : null)}>
                <th scope="row"><a href={model.sourceUrl} class="font-medium hover:text-[var(--brand-ink)]">{model.name}</a><span class="mt-1 block text-xs font-normal text-muted-foreground">{model.provider} · verified {price?.verifiedAt ?? model.verifiedAt}</span></th>
                <td><span class="font-mono text-sm">{model.providerModelId}</span><span class="mt-1 block text-xs text-muted-foreground">{model.accessNote}</span></td>
                <td>{current ? <a href={price.sourceUrl} class="num text-sm hover:text-[var(--brand-ink)]">{formatApiCost(price.inputPerMillion)} / M</a> : <span class="text-sm text-muted-foreground">Unavailable</span>}</td>
                <td>{current ? <a href={price.sourceUrl} class="num text-sm hover:text-[var(--brand-ink)]">{formatApiCost(price.outputPerMillion)} / M</a> : <span class="text-sm text-muted-foreground">Unavailable</span>}</td>
                <td data-api-cost class="num font-semibold">{formatApiCost(cost)}</td>
              </tr>;
            })}</tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-muted-foreground">Rates are USD per million text tokens. Each rate links to its vendor source and carries a verification date. Expired rates are withheld from estimates.</p>
      </section>
    </api-pricing-catalog>

    <section class="mt-10 grid gap-5 lg:grid-cols-[minmax(0,1.4fr)_minmax(17rem,.6fr)]">
      <div><p class="eyebrow mb-3"><span class="dot" aria-hidden="true"></span>Local or hosted</p><h2 class="text-xl font-semibold">An API listing is not a local download</h2><p class="mt-2 text-muted-foreground">These entries describe vendor-hosted API access. They do not imply downloadable weights, local hardware fit, benchmark parity or a global ranking. For an open-weight alternative, check your machine in <a class="text-[var(--brand-ink)] underline underline-offset-2" href="/can-i-run">the local model catalog</a> or start with <a class="text-[var(--brand-ink)] underline underline-offset-2" href="/compare/local-vs-cloud">local versus cloud</a>.</p></div>
      <details class="panel h-fit p-4"><summary class="cursor-pointer font-medium">Price scope and dates</summary><div class="mt-3 space-y-2 text-sm text-muted-foreground">{models.map((model) => <p><a href={model.pricing?.sourceUrl ?? model.sourceUrl} class="text-[var(--brand-ink)] underline underline-offset-2">{model.name}</a>: verified {model.pricing?.verifiedAt ?? model.verifiedAt}. {model.pricing?.notes ?? "No standard token rate is listed."}</p>)}</div></details>
    </section>

    <section class="mt-10" aria-labelledby="api-pricing-faq-heading"><p class="eyebrow mb-3"><span class="dot" aria-hidden="true"></span>FAQ</p><h2 id="api-pricing-faq-heading" class="sr-only">Frequently asked questions</h2><div class="panel divide-y divide-border">{faqs.map((faq) => <div class="p-4"><h3 class="font-medium">{faq.q}</h3><p class="mt-2 text-sm text-muted-foreground">{faq.a}</p></div>)}</div></section>

    <p class="mt-6 text-sm text-muted-foreground">Looking for the closed-weight boundary? Read <a class="text-[var(--brand-ink)] underline underline-offset-2" href="/guides/can-you-run-claude-locally">Can you run Claude locally?</a>. <a class="text-[var(--brand-ink)] underline underline-offset-2" href="/api/hosted-models.json">Download the dated model and price data</a>.</p>
  </article>
  <script>import "@/lib/api-pricing-client";</script>
</Base>

<style>
  .api-pricing-table { min-width: 880px; border-collapse: collapse; }
  .api-pricing-table th, .api-pricing-table td { border-bottom: 1px solid var(--border); padding: .85rem 1rem; vertical-align: top; }
  .api-pricing-table thead th { background: color-mix(in oklch, var(--color-muted) 55%, transparent); color: var(--muted-foreground); font-size: .72rem; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .api-pricing-table tbody tr:last-child > * { border-bottom: 0; }
  .api-pricing-table [hidden] { display: none; }
  @media (max-width: 640px) { .api-pricing-table th, .api-pricing-table td { padding: .7rem; } }
</style>
